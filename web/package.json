{
  "name": "bearwithme-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "ci:lint": "oxlint . --deny-warnings && eslint . --max-warnings=0",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@primeuix/themes": "3.1.1",
    "axios": "1.21.1",
    "pinia": "4.1.0",
    "primeicons": "8.0.2",
    "primevue": "5.0.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.92.0",
    "eslint-plugin-vue": "10.12.0",
    "jiti": "2.7.0",
    "jsdom": "31.0.0",
    "npm-run-all2": "9.0.4",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
