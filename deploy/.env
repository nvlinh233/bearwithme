# Non-secret local development settings. Committed on purpose.
# Single source of truth for Docker Compose, Spring Boot (dev) and Testcontainers.
# Format KEY=VALUE is valid for both Docker env files and java.util.Properties.
POSTGRES_IMAGE=postgres:16.15-alpine
POSTGRES_DB=bearwithme
POSTGRES_USER=bearwithme
POSTGRES_PASSWORD=bearwithme
POSTGRES_PORT=5433