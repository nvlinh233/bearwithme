# Non-secret local development settings. Committed on purpose.
# Single source of truth for Docker Compose, Spring Boot (dev) and Testcontainers.
# Format KEY=VALUE is valid for both Docker env files and java.util.Properties.
POSTGRES_IMAGE=postgres:16.15-alpine
POSTGRES_DB=bearwithme
POSTGRES_USER=bearwithme
POSTGRES_PASSWORD=bearwithme
POSTGRES_PORT=5433
ADMINER_IMAGE=adminer:6.1.2-standalone
ADMINER_PORT=8081

# Seeded account (FR-A1), dev only. Real environments set these as environment variables.
BWM_SEED_USERNAME=nvlinh233
BWM_SEED_PASSWORD=bearwithme-dev

# JWT (FR-A2), dev only. HS256 needs at least 32 bytes; real environments use a secret store.
BWM_JWT_SECRET=76a83d5cc569bd297eb2dcef2387d396c97aa9575eec3ce18c08ea6bf3276a99
BWM_JWT_ISSUER=bearwithme-dev
